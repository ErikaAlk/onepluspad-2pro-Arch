#%PAM-1.0

auth       requisite                   pam_shells.so
auth       requisite                   pam_nologin.so
auth       requisite                   pam_faillock.so preauth silent
auth       required                    pam_env.so
auth       [success=ok default=1]       pam_howdy.so
auth       [success=done default=die]   pam_faillock.so authsucc
auth       include                     system-local-login
-auth      optional                    pam_gnome_keyring.so
-auth      optional                    pam_oo7.so

account    include                     system-local-login

password   include                     system-local-login
-password  optional                    pam_gnome_keyring.so use_authtok
-password  optional                    pam_oo7.so use_authtok

session    include                     system-local-login
-session   optional                    pam_gnome_keyring.so auto_start
-session   optional                    pam_oo7.so auto_start
