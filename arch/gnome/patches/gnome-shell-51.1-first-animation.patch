+typedef struct
+{
+  CRStatement *statement;
+  CRSelector *selector;
+} SelectorCandidate;
+
+#ifdef ST_VERIFY_SELECTOR_CACHE
+static gboolean verify_unfiltered;
+#endif
+
+static GArray *
+get_selector_candidates (StTheme      *theme,
+                         CRStyleSheet *sheet,
+                         StThemeNode  *node)
+{
+  const char *empty[] = { NULL };
+  GStrv classes = st_theme_node_get_element_classes (node);
+  GStrv pseudo_classes = st_theme_node_get_pseudo_classes (node);
+  g_autoptr (GVariant) fields = NULL;
+  g_autoptr (GBytes) key = NULL;
+  GArray *candidates;
+  CRStatement *statement;
+  gboolean filtered = TRUE;
+
+#ifdef ST_VERIFY_SELECTOR_CACHE
+  filtered = !verify_unfiltered;
+#endif
+
+  fields = g_variant_ref_sink (g_variant_new ("(ttms^as^as)",
+                                            (guint64) (guintptr) sheet,
+                                            (guint64) st_theme_node_get_element_type (node),
+                                            st_theme_node_get_element_id (node),
+                                            classes ? (const char * const *) classes : empty,
+                                            pseudo_classes ? (const char * const *) pseudo_classes : empty));
+  key = g_variant_get_data_as_bytes (fields);
+  candidates = filtered ? g_hash_table_lookup (theme->selector_candidates, key) : NULL;
+  if (candidates)
+    return g_array_ref (candidates);
+
+  /* 限制缓存容量；遍历方持有引用，导入期间清理缓存不会释放正在使用的列表。 */
+  if (filtered && g_hash_table_size (theme->selector_candidates) >= 2048)
+    g_hash_table_remove_all (theme->selector_candidates);
+
+  candidates = g_array_new (FALSE, FALSE, sizeof (SelectorCandidate));
+  for (statement = sheet->statements; statement; statement = statement->next)
+    {
+      if (statement->type == AT_IMPORT_RULE_STMT)
+        {
+          SelectorCandidate entry = { statement, NULL };
+          g_array_append_val (candidates, entry);
+        }
+      else if (statement->type == RULESET_STMT && statement->kind.ruleset)
+        {
+          CRSelector *selector;
+          for (selector = statement->kind.ruleset->sel_list; selector; selector = selector->next)
+            {
+              gboolean matches = FALSE;
+              enum CRStatus status;
+
+              if (!selector->simple_sel)
+                continue;
+              status = CR_OK;
+              matches = TRUE;
+              if (filtered)
+                status = sel_matches_style_real (theme, selector->simple_sel, node,
+                                                 &matches, TRUE, FALSE);
+              if (status == CR_OK && matches)
+                {
+                  SelectorCandidate entry = { statement, selector };
+                  g_array_append_val (candidates, entry);
+                }
+            }
+        }
+    }
+  if (filtered)
+    g_hash_table_insert (theme->selector_candidates, g_bytes_ref (key), g_array_ref (candidates));
+  return candidates;
+}
+
