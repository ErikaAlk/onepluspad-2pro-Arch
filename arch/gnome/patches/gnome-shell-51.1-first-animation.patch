   gboolean matches = FALSE;
   enum CRStatus status = CR_OK;
+  g_autoptr (GArray) candidates = get_selector_candidates (a_this, a_nodesheet, a_node);
 
   /*
    *walk through the list of statements and,
@@ -874,8 +960,10 @@ add_matched_properties (StTheme      *a_this,
    *contain some, and try to match our style node in these
    *selectors lists.
    */
-  for (cur_stmt = a_nodesheet->statements; cur_stmt; cur_stmt = cur_stmt->next)
+  for (guint index = 0; index < candidates->len; index++)
     {
+      SelectorCandidate *candidate = &g_array_index (candidates, SelectorCandidate, index);
+      cur_stmt = candidate->statement;
       /*
        *initialize the selector list in which we will
        *really perform the search.
@@ -891,7 +979,7 @@ add_matched_properties (StTheme      *a_this,
         case RULESET_STMT:
           if (cur_stmt->kind.ruleset && cur_stmt->kind.ruleset->sel_list)
             {
-              sel_list = cur_stmt->kind.ruleset->sel_list;
+              sel_list = candidate->selector;
             }
           break;
 
@@ -952,7 +1040,7 @@ add_matched_properties (StTheme      *a_this,
        *let's walk it and try to match the style node
        *on each item of the list.
        */
-      for (cur_sel = sel_list; cur_sel; cur_sel = cur_sel->next)
+      for (cur_sel = sel_list; cur_sel; cur_sel = NULL)
         {
           if (!cur_sel->simple_sel)
             continue;
@@ -1052,6 +1140,33 @@ _st_theme_get_matched_properties (StTheme        *theme,
    * after earlier declarations */
   g_ptr_array_sort (props, compare_declarations);
 
+#ifdef ST_VERIFY_SELECTOR_CACHE
+  if (!verify_unfiltered)
+    {
+      g_autoptr (GPtrArray) reference = NULL;
+      g_autoptr (GArray) specificity = g_array_new (FALSE, FALSE, sizeof (gulong));
+
+      for (guint index = 0; index < props->len; index++)
+        {
+          CRDeclaration *declaration = g_ptr_array_index (props, index);
+          gulong value = declaration->parent_statement->specificity;
+          g_array_append_val (specificity, value);
+        }
+      /* 对比原始完整扫描的声明顺序、重复次数与最终specificity。 */
+      verify_unfiltered = TRUE;
+      reference = _st_theme_get_matched_properties (theme, node);
+      verify_unfiltered = FALSE;
+      g_assert_cmpuint (props->len, ==, reference->len);
+      for (guint index = 0; index < props->len; index++)
+        {
+          CRDeclaration *declaration = g_ptr_array_index (props, index);
+          g_assert_true (declaration == g_ptr_array_index (reference, index));
+          g_assert_cmpuint (g_array_index (specificity, gulong, index), ==,
+                            declaration->parent_statement->specificity);
+        }
+    }
+#endif
+
   return props;
 }
 
