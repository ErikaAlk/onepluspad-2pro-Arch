pkgname=gnome-settings-daemon
pkgver=51.1
pkgrel=1.1
pkgdesc='GNOME 设置服务，包含电源按钮锁屏与零照度调节'
arch=(aarch64)
url=https://gitlab.gnome.org/GNOME/gnome-settings-daemon
license=(GPL-2.0-or-later LGPL-2.0-or-later)
groups=(gnome)
backup=(etc/xdg/Xwayland-session.d/00-xrdb)
depends=(alsa-lib bash dconf fontconfig gcr-4 geoclue geocode-glib-2 glib2 glibc
  gnome-desktop-4 gsettings-desktop-schemas gtk4 libcanberra-pulse libcolord libcups
  libgcc libgudev libgweather-4 libmm-glib libnm libnotify libp11-kit libpulse libx11
  libxfixes polkit pulse-native-provider systemd-libs upower)
optdepends=('usbguard: USB 保护')
options=(!strip !debug)
source=(http://mirror.archlinuxarm.org/aarch64/extra/gnome-settings-daemon-51.1-1-aarch64.pkg.tar.xz
  gnome-51.1-power-fixes-aarch64.tar.xz)
noextract=("${source[@]##*/}")
sha256sums=(2398ce0b78923eb42f2bf755dbb322a1d3e6ab185e53005f1e5e90278bb074cc
  36b7bbe549c7117b1062d52fbb12822e1cebec74ea4d8d15166ddd81e545ffce)

package() {
  bsdtar --no-same-owner -xf "$srcdir/gnome-settings-daemon-51.1-1-aarch64.pkg.tar.xz" -C "$pkgdir" --exclude '.*'
  bsdtar --no-same-owner -xf "$srcdir/gnome-51.1-power-fixes-aarch64.tar.xz" -C "$pkgdir" \
    usr/lib/gsd-media-keys usr/lib/gsd-power \
    usr/share/glib-2.0/schemas/org.gnome.settings-daemon.enums.xml \
    usr/share/glib-2.0/schemas/org.gnome.settings-daemon.plugins.power.gschema.xml
}
