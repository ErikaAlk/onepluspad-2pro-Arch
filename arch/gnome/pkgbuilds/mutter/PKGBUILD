pkgname=mutter
pkgver=51.1
pkgrel=1.1
pkgdesc='GNOME 窗口管理器与合成器，包含一加平板电源与 XWayland 修复'
arch=(aarch64)
url=https://gitlab.gnome.org/GNOME/mutter
license=(GPL-2.0-or-later)
depends=(at-spi2-core cairo colord dconf egl-wayland fontconfig fribidi gdk-pixbuf2
  glib2 glibc glycin gnome-desktop-4 gnome-settings-daemon graphene gsettings-desktop-schemas
  gtk4 harfbuzz iio-sensor-proxy lcms2 libcanberra libcolord libdisplay-info libdrm libei
  libgcc libgirepository libglvnd libgudev libinput libpipewire libsysprof-capture libwacom
  libx11 libxau libxcb libxcomposite libxcursor libxdamage libxext libxfixes libxi libxinerama
  libxkbcommon libxrandr mesa pango pipewire pixman python python-argcomplete python-dbus
  python-gobject startup-notification systemd-libs wayland xorg-xwayland)
optdepends=('bash-completion: gdctl 的 Bash 补全' 'mutter-devkit: Mutter SDK')
provides=(libmutter-51.so)
options=(!strip !debug)
source=(http://mirror.archlinuxarm.org/aarch64/extra/mutter-51.1-1-aarch64.pkg.tar.xz
  gnome-51.1-power-fixes-aarch64.tar.xz)
noextract=("${source[@]##*/}")
sha256sums=(c3841fe96f964be72c4538a790dad8166d66b2feafe2aa23a325ddbfa84e2a3c
  36b7bbe549c7117b1062d52fbb12822e1cebec74ea4d8d15166ddd81e545ffce)

package() {
  bsdtar --no-same-owner -xf "$srcdir/mutter-51.1-1-aarch64.pkg.tar.xz" -C "$pkgdir" --exclude '.*'
  bsdtar --no-same-owner -xf "$srcdir/gnome-51.1-power-fixes-aarch64.tar.xz" -C "$pkgdir" usr/lib/libmutter-51.so.0.0.0
}
