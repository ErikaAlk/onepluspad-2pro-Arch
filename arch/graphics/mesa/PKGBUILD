pkgbase=mesa
pkgname=(mesa vulkan-freedreno vulkan-mesa-implicit-layers)
pkgver=26.2.6
pkgrel=1.3
epoch=1
pkgdesc='适用于Adreno 830的Mesa图形驱动'
arch=(aarch64)
url=https://www.mesa3d.org/
license=('MIT AND BSD-3-Clause AND SGI-B-2.0')
options=(!strip !debug !lto)
source=(erhai-graphics-26.2.6-1.3-aarch64.tar.zst)
sha256sums=(4b27ca344f7ef1c65a57207c78377e0ff0d4c9ed0721a52332802cc5352a6b76)

package_mesa() {
  depends=(expat glibc libdrm libelf libgcc libglvnd libstdc++ libx11 libxcb libxext libxshmfence libxxf86vm wayland zlib zstd)
  provides=("libva-mesa-driver=$epoch:$pkgver-$pkgrel" "mesa-libgl=$epoch:$pkgver-$pkgrel" opengl-driver)
  conflicts=('libva-mesa-driver<1:24.2.7-1' 'mesa-libgl<17.0.1-2')
  replaces=('libva-mesa-driver<1:24.2.7-1' 'mesa-libgl<17.0.1-2')
  cp -a "$srcdir/host-install/usr" "$pkgdir/"
  rm "$pkgdir/usr/lib/libvulkan_freedreno.so" "$pkgdir/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json" "$pkgdir/usr/lib/libVkLayer_MESA_device_select.so" "$pkgdir/usr/share/vulkan/implicit_layer.d/VkLayer_MESA_device_select.json"
  ln -s libGLX_mesa.so.0 "$pkgdir/usr/lib/libGLX_indirect.so.0"
  install -Dm644 "$srcdir/metadata/mesa/license.rst" "$pkgdir/usr/share/licenses/mesa/license.rst"
  install -Dm644 "$srcdir/metadata/mesa/source.json" "$pkgdir/usr/share/doc/mesa/erhai-source.json"
  install -Dm644 "$srcdir/metadata/mesa/"*.patch -t "$pkgdir/usr/share/doc/mesa/erhai-patches/"
}

package_vulkan-freedreno() {
  pkgdesc='适用于Adreno GPU的Turnip Vulkan驱动'
  depends=(expat glibc libdrm libgcc libstdc++ libx11 libxcb libxshmfence systemd-libs vulkan-icd-loader vulkan-mesa-implicit-layers wayland zlib zstd)
  provides=(vulkan-driver)
  install -Dm755 "$srcdir/host-install/usr/lib/libvulkan_freedreno.so" "$pkgdir/usr/lib/libvulkan_freedreno.so"
  install -Dm644 "$srcdir/host-install/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json" "$pkgdir/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json"
  install -Dm644 "$srcdir/metadata/mesa/license.rst" "$pkgdir/usr/share/licenses/vulkan-freedreno/license.rst"
}

package_vulkan-mesa-implicit-layers() {
  pkgdesc='Mesa Vulkan设备选择层'
  depends=(glibc libdrm libxcb wayland)
  conflicts=(vulkan-mesa-device-select)
  replaces=(vulkan-mesa-device-select)
  install -Dm755 "$srcdir/host-install/usr/lib/libVkLayer_MESA_device_select.so" "$pkgdir/usr/lib/libVkLayer_MESA_device_select.so"
  install -Dm644 "$srcdir/host-install/usr/share/vulkan/implicit_layer.d/VkLayer_MESA_device_select.json" "$pkgdir/usr/share/vulkan/implicit_layer.d/VkLayer_MESA_device_select.json"
  install -Dm644 "$srcdir/metadata/mesa/license.rst" "$pkgdir/usr/share/licenses/vulkan-mesa-implicit-layers/license.rst"
}
