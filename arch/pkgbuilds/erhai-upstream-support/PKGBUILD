pkgname=erhai-upstream-support
pkgver=0.6.0
pkgrel=1
pkgdesc='一加平板 2 Pro 电源键与合盖休眠、相机调校、SoCCP 固件与联网校时'
arch=(any)
url=https://github.com/yzddmr6/onepluspad-2pro-mainline
license=(GPL-2.0-only)
depends=(python chrony systemd mkinitcpio networkmanager)
backup=(etc/chrony-erhai.conf etc/systemd/logind.conf.d/95-erhai-lid.conf)
options=(!strip)
source=(
  erhai-arch-v0.6.0.tar.gz
  chrony.conf erhai-cover.service 90-erhai-power.conf mkinitcpio.conf chronyd-erhai.conf power-key-arch.conf
  90-erhai-chrony-dhcp
)
sha256sums=(
  110e2e7f160a595fed0963287e2ce2887e9896a35f84dbabdf076917407ee945
  948c6fb879d69ed581fd2b618681f7e874b56f29a950a7c611bc5f11990c794a
  add6ef7561f7c69b7ef1df16286af1fd01431cb910662546aa41a166a784da52
  cb81e1c2c74ea3f0f1d9200a18304b0fea68b9d7b2567d7202e312fd2450b720
  0e32981104f718f5d3f5087776ff136ac66c5bd81ea7452b0d014a6bbb713042
  0c0dd137204b26d7c360c9d370c74ad922b9889a126dbd38afce31f0656140c2
  e414caf18f548abd84c5f7157042c262040502c43380db26beabeca12780ca33
  64ccef02bdb6256992b4d0707c649f6a9c7121dec70540ca90b65d916a2dc592
