package() {
  local upstream=onepluspad-2pro-mainline-0.9.1/packaging
  local tree=$upstream/erhai-device-support/tree
  local relative
  for relative in \
    etc/tuned/erhai-ppd.conf \
    usr/lib/systemd/system/tuned-ppd.service.d/50-erhai-profiles.conf \
    usr/lib/systemd/zram-generator.conf.d/50-erhai.conf \
    usr/lib/systemd/logind.conf.d/95-tablet-charge.conf \
    usr/lib/tuned/profiles/erhai-balanced/tuned.conf \
    usr/lib/tuned/profiles/erhai-performance/tuned.conf \
    usr/lib/tuned/profiles/erhai-power-saver/tuned.conf \
    usr/lib/udev/rules.d/80-erhai-charge-limit.rules \
    usr/lib/udev/rules.d/90-erhai-internal-storage.rules \
    usr/share/glib-2.0/schemas/95_tablet-charge.gschema.override \
    usr/share/glib-2.0/schemas/io.github.yzddmr6.erhai.desktop.gschema.xml \
    usr/share/libcamera/ipa/simple/sc1300cs.yaml \
    usr/share/libcamera/ipa/simple/sc820cs.yaml \
    usr/share/doc/erhai-device-support/gunyahvm-favorite.COPYING \
    etc/xdg/autostart/erhai-gunyahvm-favorite.desktop; do
    install -Dm644 "$tree/$relative" "$pkgdir/$relative"
  done
  install -Dm755 "$tree/usr/libexec/erhai/gunyahvm-favorite" "$pkgdir/usr/libexec/erhai/gunyahvm-favorite"
  install -Dm755 "$tree/usr/sbin/erhai-cover" "$pkgdir/usr/bin/erhai-cover"
  install -Dm644 erhai-cover.service "$pkgdir/usr/lib/systemd/system/erhai-cover.service"
  install -Dm644 chrony.conf "$pkgdir/etc/chrony-erhai.conf"
  install -Dm644 chronyd-erhai.conf "$pkgdir/usr/lib/systemd/system/chronyd.service.d/90-erhai.conf"
  install -Dm755 90-erhai-chrony-dhcp "$pkgdir/usr/lib/NetworkManager/dispatcher.d/90-erhai-chrony-dhcp"
  install -Dm644 90-erhai-power.conf "$pkgdir/etc/systemd/logind.conf.d/95-erhai-lid.conf"
  install -Dm644 mkinitcpio.conf "$pkgdir/etc/mkinitcpio.conf.d/90-erhai-soccp.conf"
  install -Dm644 90_erhai-power.gschema.override "$pkgdir/usr/share/glib-2.0/schemas/90_erhai-power.gschema.override"
  install -Dm644 cleanup-tuned.py "$pkgdir/usr/lib/erhai/cleanup-tuned.py"
  install -Dm644 "$upstream/firmware/qcom/sm8750/erhai/soccp.mbn" "$pkgdir/usr/lib/firmware/qcom/sm8750/erhai/soccp.mbn"
  install -Dm644 "$upstream/firmware-manifest.json" "$pkgdir/usr/share/doc/$pkgname/firmware-manifest.json"
  install -Dm644 "$upstream/firmware/README.md" "$pkgdir/usr/share/doc/$pkgname/firmware-README.md"
}
