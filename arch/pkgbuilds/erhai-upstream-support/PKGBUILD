package() {
  local upstream=onepluspad-2pro-mainline-0.6.0/packaging
  local tree=$upstream/erhai-device-support/tree
  install -Dm755 "$tree/usr/sbin/erhai-power-key" "$pkgdir/usr/bin/erhai-power-key"
  install -Dm644 "$tree/usr/lib/systemd/system/erhai-power-key@.service" \
    "$pkgdir/usr/lib/systemd/system/erhai-power-key@.service"
  install -Dm644 power-key-arch.conf \
    "$pkgdir/usr/lib/systemd/system/erhai-power-key@.service.d/90-erhai-arch.conf"
  install -Dm755 "$tree/usr/lib/systemd/system-sleep/erhai-suspend-cycle.sh" \
    "$pkgdir/usr/lib/systemd/system-sleep/erhai-suspend-cycle.sh"
  install -Dm644 "$tree/usr/lib/udev/rules.d/82-erhai-power-key.rules" \
    "$pkgdir/usr/lib/udev/rules.d/82-erhai-power-key.rules"
  install -Dm644 "$tree/usr/share/glib-2.0/schemas/90_erhai-power.gschema.override" \
    "$pkgdir/usr/share/glib-2.0/schemas/90_erhai-power.gschema.override"
  install -Dm644 "$tree/usr/share/libcamera/ipa/simple/sc1300cs.yaml" \
    "$pkgdir/usr/share/libcamera/ipa/simple/sc1300cs.yaml"
  install -Dm644 "$tree/usr/share/libcamera/ipa/simple/sc820cs.yaml" \
    "$pkgdir/usr/share/libcamera/ipa/simple/sc820cs.yaml"
  install -Dm755 "$upstream/erhai-device-support/tree/usr/sbin/erhai-cover" "$pkgdir/usr/bin/erhai-cover"
  install -Dm644 erhai-cover.service "$pkgdir/usr/lib/systemd/system/erhai-cover.service"
  install -Dm644 chrony.conf "$pkgdir/etc/chrony-erhai.conf"
  install -Dm644 chronyd-erhai.conf "$pkgdir/usr/lib/systemd/system/chronyd.service.d/90-erhai.conf"
  install -Dm755 90-erhai-chrony-dhcp "$pkgdir/usr/lib/NetworkManager/dispatcher.d/90-erhai-chrony-dhcp"
  install -Dm644 90-erhai-power.conf "$pkgdir/etc/systemd/logind.conf.d/95-erhai-lid.conf"
  install -Dm644 mkinitcpio.conf "$pkgdir/etc/mkinitcpio.conf.d/90-erhai-soccp.conf"
  install -Dm644 "$upstream/firmware/qcom/sm8750/erhai/soccp.mbn" \
    "$pkgdir/usr/lib/firmware/qcom/sm8750/erhai/soccp.mbn"
  install -Dm644 "$upstream/firmware-manifest.json" "$pkgdir/usr/share/doc/$pkgname/firmware-manifest.json"
  install -Dm644 "$upstream/firmware/README.md" "$pkgdir/usr/share/doc/$pkgname/firmware-README.md"
}
