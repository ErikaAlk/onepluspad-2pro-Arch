pkgname=erhai-upstream-support
pkgver=0.9.1
pkgrel=1
pkgdesc='一加平板 2 Pro 电源策略、相机调校、联网校时与压缩交换空间'
arch=(any)
url=https://github.com/ErikaAlk/onepluspad-2pro-Arch
license=(GPL-2.0-only)
depends=(python python-gobject chrony systemd mkinitcpio networkmanager tuned-ppd zram-generator)
backup=(etc/chrony-erhai.conf etc/systemd/logind.conf.d/95-erhai-lid.conf etc/tuned/erhai-ppd.conf)
options=(!strip)
install=erhai-upstream-support.install
source=(
  erhai-arch-v0.9.1.tar.gz
  chrony.conf erhai-cover.service 90-erhai-power.conf mkinitcpio.conf chronyd-erhai.conf
  90-erhai-chrony-dhcp
  90_erhai-power.gschema.override
  cleanup-tuned.py
)
sha256sums=(
  68a85a7104f306d4d6234e9f2eb3ef0ec41ee105b9bd5f928e25008a92e2c2b0
  948c6fb879d69ed581fd2b618681f7e874b56f29a950a7c611bc5f11990c794a
  add6ef7561f7c69b7ef1df16286af1fd01431cb910662546aa41a166a784da52
  cb81e1c2c74ea3f0f1d9200a18304b0fea68b9d7b2567d7202e312fd2450b720
  0e32981104f718f5d3f5087776ff136ac66c5bd81ea7452b0d014a6bbb713042
  0c0dd137204b26d7c360c9d370c74ad922b9889a126dbd38afce31f0656140c2
  64ccef02bdb6256992b4d0707c649f6a9c7121dec70540ca90b65d916a2dc592
  54b95aad788db50e5fb47a86d63d77b34162c152298cd774f08375f9f6700a1b
  e6f11ed0f350ade66b1fcefe1f66070eee111efa87d17e70d2e6dfe4b5907fe7
