prepare() {
  local item
  for item in "${source[@]:0:4}"; do
    dpkg-deb -x "$item" payload
  done
  for item in "${source[@]:4}"; do
    dpkg-deb -x "$item" dependencies
  done
}

package() {
  cp -a payload/usr payload/etc "$pkgdir/"
  install -d "$pkgdir/usr/lib/gunyahvm/host-libs" "$pkgdir/usr/lib/girepository-1.0"
  cp -a dependencies/usr/lib/aarch64-linux-gnu/*.so* "$pkgdir/usr/lib/gunyahvm/host-libs/"
  install -Dm644 dependencies/usr/lib/aarch64-linux-gnu/girepository-1.0/Casilda-1.0.typelib \
    "$pkgdir/usr/lib/girepository-1.0/Casilda-1.0.typelib"
  local item
  for item in "$pkgdir/usr/lib/gunyahvm/host-libs/"*.so*; do
    [[ -L $item ]] && continue
    patchelf --set-rpath '/usr/lib/gunyahvm/host-libs:$ORIGIN:/usr/lib' "$item"
  done
  ln -s gunyahvm/host-libs/libcasilda-1.0.so.1 "$pkgdir/usr/lib/libcasilda-1.0.so.1"
  cp -a dependencies/usr/share/doc/. "$pkgdir/usr/share/doc/"
}
